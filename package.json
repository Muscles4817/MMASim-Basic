{
  "name": "mmasim",
  "version": "0.1.0",
  "private": true,
  "description": "MMA Sim — a deep, mobile-first MMA management/career simulation.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mmasim/app",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --project unit --project integration --project ui",
    "test:watch": "vitest",
    "test:long": "vitest run --project long-sim",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/data && tsc --noEmit -p packages/app && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test:ui": "vitest run --project ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
