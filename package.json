{
  "name": "mmasim",
  "version": "0.1.0",
  "private": true,
  "description": "MMA Sim — a deep, mobile-first MMA management/career simulation.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mmasim/app",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:long": "vitest run --project long-sim",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/data && tsc --noEmit -p packages/app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
