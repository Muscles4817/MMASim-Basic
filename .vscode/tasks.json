{
  "version": "2.0.0",
  "tasks": [
    {
      // Started automatically by the "Play MMA Sim" launch configuration.
      //
      // The `problemMatcher` is what makes F5 work reliably: without the `endsPattern`,
      // VS Code has no idea when Vite is actually listening and launches the browser at a
      // dead port. `isBackground` keeps the task running rather than waiting for it to exit.
      "label": "dev server",
      "type": "shell",
      "command": "npm run dev --workspace @mmasim/app",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^\\s*(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(Local:|ready in).*"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "npm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test: long sim",
      "type": "shell",
      "command": "npm run test:long",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    }
  ]
}
